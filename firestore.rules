rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default-deny catch-all: everything not explicitly allowed below is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Public catalog collections (read-only from the web; fed via seed script / Firebase console)
    match /cities/{cityId} {
      allow read: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
    }

    match /venues/{venueId} {
      allow read: if true;
    }

    match /organizers/{organizerId} {
      allow read: if true;
    }

    // 2. Visitor profiles & favorites: users/{visitorId}/favorites/{eventId}
    //    Without Firebase Auth there is no verifiable server-side identity: ownership relies
    //    on the unguessable visitorId generated locally (crypto.randomUUID) and kept in
    //    localStorage. This is demo-grade security, appropriate for a hackathon.
    match /users/{visitorId} {
      allow read, create, update, delete: if true;

      match /favorites/{eventId} {
        allow read, create, delete: if true;
      }
    }

    // 3. Events catalog
    match /events/{eventId} {
      // Public cartelera: published events. pending_review is readable so the
      // curation panel can list the queue.
      allow read: if existing().publicationStatus in ['published', 'pending_review'];

      // Community submissions (sent by the web form) always enter as 'pending_review'
      // and can never self-verify. Non-community sources (seed tooling) may publish directly.
      allow create: if (
        incoming().publicationStatus == 'pending_review' &&
        incoming().verificationStatus == 'pending' &&
        incoming().sourceType == 'community'
      ) || (
        incoming().publicationStatus in ['published', 'pending_review'] &&
        incoming().sourceType != 'community'
      );

      // Approvals / rejections are performed from the curation panel (simple client-side
      // passcode). Without Firebase Auth these rules cannot verify a real admin identity,
      // so updates are open: demo-grade security, fine for a hackathon.
      allow update: if true;

      // Deletions only via Firebase console / Admin SDK tooling.
      allow delete: if false;
    }

    // 4. Moderation audit trail (written by the curation panel)
    match /moderationQueue/{itemId} {
      allow read, create: if true;
    }

    // 5. Community event reports
    match /eventReports/{reportId} {
      allow read, create: if true;
    }
  }
}
